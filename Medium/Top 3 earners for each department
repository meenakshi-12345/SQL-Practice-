WITH CTE AS (
SELECT d.department_name AS department_name,e.name AS name,e.salary AS salary, ROW_NUMBER() OVER(PARTITION BY d.department_name ORDER BY e.salary DESC) AS rnk
FROM department d 
JOIN employee e ON e.department_id = d.department_id 

)
SELECT department_name,name, salary 
FROM CTE 
WHERE rnk<=3
ORDER BY department_name 
