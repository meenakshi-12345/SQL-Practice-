WITH CTE AS (
SELECT customer_id, YEAR(purchase_date) AS yr, SUM(purchase_amount) AS spend
FROM customer_purchases
GROUP BY customer_id, YEAR(purchase_date)  ),
prev_spend AS ( 

SELECT *, LAG(spend) OVER(PARTITION BY customer_id ORDER BY yr) AS prev_spend
FROM CTE
ORDER BY customer_Id )

SELECT *, ROUND(((spend-prev_spend)*100.0/prev_spend),2) AS yoy_pct
FROM prev_spend
ORDER BY customer_Id
