WITH CTE AS (
SELECT DATE(measurement_time) AS day,measurement_value, ROW_NUMBER() OVER(PARTITION BY DATE(measurement_time) ORDER BY DATE(measurement_time)) AS row_num 
FROM measurements 
 )
 SELECT day, 
 SUM(CASE WHEN row_num%2!=0 THEN measurement_value END) AS odd_sum,
 SUM(CASE WHEN row_num%2=0 THEN measurement_value END) AS even_sum 
 FROM CTE
 GROUP BY day
 
