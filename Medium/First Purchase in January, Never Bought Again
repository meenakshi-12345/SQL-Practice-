SELECT o.customer_id, c.name
FROM orders o 
JOIN customers c ON c.customer_id = o.customer_id
WHERE o.customer_id NOT IN (
                            SELECT customer_id FROM orders WHERE order_date>'2024-01-31')
GROUP BY o.customer_id 
HAVING MIN(o.order_date) BETWEEN '2024-01-01' AND '2024-01-31'
