WITH CTE AS (
SELECT e.visit_id,p.page_name AS page_name, ROW_NUMBER() OVER(PARTITION BY e.visit_id ORDER BY e.sequence_number) AS row_num
FROM events e 
JOIN Page_hierarchy p ON e.page_id = p.page_id
),
CTE2 AS (
SELECT e.visit_id,p.page_name AS page_name, ROW_NUMBER() OVER(PARTITION BY e.visit_id ORDER BY e.sequence_number DESC) AS row_num2
FROM events e 
JOIN Page_hierarchy p ON e.page_id = p.page_id
)

SELECT a.visit_id 
FROM CTE a
JOIN CTE2 b ON a.visit_id = b.visit_id 
WHERE (a.page_name = "Home Page" AND a.row_num =1)  AND (b.page_name = "Salmon" AND b.row_num2 = 1)
