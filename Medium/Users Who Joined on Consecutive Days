WITH CTE AS (
SELECT user_id, cookie_id, start_date AS start_date, LAG(start_date) OVER(ORDER BY  user_id) AS previous_date
FROM Users
  ), days_diff AS (
  SELECT user_id,cookie_id,start_date, julianday(start_date) - julianday(previous_date) AS date_diff
FROM CTE
    )   
    SELECT *
    FROM days_diff 
    WHERE date_diff=1
