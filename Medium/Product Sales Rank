WITH CTE AS (
SELECT p.product_id, p.name, COUNT(o.product_id) AS times_ordered, ROUND(SUM(o.quantity*o.unit_price),2) AS total_revenue
FROM products p 
JOIN order_items o ON o.product_id = p.product_id
GROUP BY p.product_id, p.name
  )
  SELECT *, DENSE_RANK() OVER(ORDER BY times_ordered DESC) AS order_rank, 
      			DENSE_RANK() OVER(ORDER BY total_revenue DESC) AS revenue_rank 
            FROM CTE
