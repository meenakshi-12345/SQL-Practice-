WITH CTE AS (
SELECT e.employee_id AS employee_id, COALESCE(COUNT(DISTINCT q.query_id), 0) AS query_count 
FROM employees e 
LEFT JOIN queries q ON q.employee_id = e.employee_id 
AND q.query_starttime >= '07/01/2023' AND q.query_starttime < '10/01/2023'
GROUP BY e.employee_id
)
SELECT query_count AS unique_queries, COUNT(employee_id) AS employee_count 
FROM CTE 
GROUP BY unique_queries
ORDER BY query_count
